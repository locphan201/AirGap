+/// Generates a URL-friendly anchor slug from heading text.
+///
+/// Rules:
+/// 1. Lowercases all characters.
+/// 2. Converts whitespace and underscores to hyphens.
+/// 3. Retains alphanumeric characters and hyphens.
+/// 4. Strips non-alphanumeric characters (punctuation, symbols).
+/// 5. Collapses consecutive hyphens.
+/// 6. Trims leading and trailing hyphens.
+pub fn generate_slug(text: &str) -> String {
+    let mut slug = String::with_capacity(text.len());
+    let mut prev_was_hyphen = false;
+
+    for c in text.chars() {
+        if c.is_alphanumeric() {
+            for lc in c.to_lowercase() {
+                slug.push(lc);
+            }
+            prev_was_hyphen = false;
+        } else if c.is_whitespace() || c == '-' || c == '_' {
+            if !prev_was_hyphen && !slug.is_empty() {
+                slug.push('-');
+                prev_was_hyphen = true;
+            }
+        }
+    }
+
+    if slug.ends_with('-') {
+        slug.pop();
+    }
+
+    slug
+}
