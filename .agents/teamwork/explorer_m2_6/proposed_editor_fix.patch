+    #[test]
+    fn test_find_current_line_utf8_char_boundary_safety() {
+        let text = "你好世界\n第二行🚀emoji";
+        // Byte 1 and 2 are inside '你' (3-byte char 0..3)
+        let (start, line) = find_current_line(text, 2);
+        assert_eq!(start, 0);
+        assert_eq!(line, "你好世界");
+
+        // Byte inside emoji (4-byte sequence)
+        let emoji_offset = text.find('🚀').unwrap() + 1;
+        let (start2, line2) = find_current_line(text, emoji_offset);
+        assert_eq!(line2, "第二行🚀emoji");
+        assert!(start2 > 0);
+    }
+
+    #[test]
+    fn test_char_idx_to_byte_idx() {
+        let text = "a你好b";
+        assert_eq!(char_idx_to_byte_idx(text, 0), 0); // 'a'
+        assert_eq!(char_idx_to_byte_idx(text, 1), 1); // '你'
+        assert_eq!(char_idx_to_byte_idx(text, 2), 4); // '好'
+        assert_eq!(char_idx_to_byte_idx(text, 3), 7); // 'b'
+        assert_eq!(char_idx_to_byte_idx(text, 4), 8); // EOF
+        assert_eq!(char_idx_to_byte_idx(text, 99), 8); // Out of bounds
+    }
